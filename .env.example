NODE_ENV=development
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Lana API — https://orbmarkets.io/lana-api/docs
LANA_API_KEY=your_lana_api_key
LANA_BASE_URL=https://beta.helius-rpc.com/v1/lana/messages
LANA_MODEL_FAST=lana-fast
LANA_MODEL_THINKING=lana-thinking
LANA_MAX_TOKENS=4096
LANA_ENABLE_DEEP_SCAN=false
LANA_NETWORK=devnet
LANA_TIMEOUT_MS=180000
LANA_RETRY_ATTEMPTS=2
LANA_STREAM=true
LANA_TIMEZONE=UTC

# Helius & Solana Privacy Rings (SPR) Configuration
HELIUS_API_KEY=your_helius_api_key
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=your_helius_api_key
WALLET_ENCRYPTION_KEY=replace_with_a_secure_random_secret_for_wallet_encryption
DATA_DIR=./data

SESSION_HISTORY_LIMIT=8
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
